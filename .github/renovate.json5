{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Source-side dependency and security automation: routine updates on the default branch and
  // security-only fixes on the maintained release branches.
  //
  // Not extending config:recommended on purpose — its ignorePaths drops **/test/**, which would
  // stop updating the Dockerfiles under /test/*.

  // Confine routine PRs to Monday morning (UTC). Security fixes ignore `schedule` and always open.
  schedule: ["* 6-11 * * 1"],

  enabledManagers: ["npm", "github-actions", "gomod", "dockerfile"],

  // Keep /test/** in scope so the test Dockerfiles stay covered.
  ignorePaths: ["**/node_modules/**"],

  semanticCommits: "enabled",
  semanticCommitType: "chore",       // commit as chore(deps): — parsed by cliff.toml
  minimumReleaseAge: "3 days",       // cooldown to avoid just-published versions
  minimumReleaseAgeBehaviour: "timestamp-optional", // don't stall versions that lack a release timestamp (else lowest security fixes get held)
  postUpdateOptions: ["gomodTidy"],  // run `go mod tidy` after gomod changes
  dependencyDashboard: true,         // tracking issue for pending updates

  labels: ["dependencies"],

  // PRs auto-open. For a gated rollout, add `dependencyDashboardApproval: true`, approve from the
  // dashboard, then remove it.

  // Route every PR to the maintainers team.
  reviewers: ["team:gatekeeper-maintainers"],

  // Default branch + maintained release lines. The workflow narrows the release branches actually
  // processed to n/n-1 at runtime via RENOVATE_BASE_BRANCH_PATTERNS, so this stays a generic regex.
  baseBranchPatterns: ["$default", "/^release-3\\.\\d+$/"],

  // OSV scans branch content, so it surfaces vulnerabilities on the release branches too.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    vulnerabilityFixStrategy: "lowest", // take the earliest fixed version
    labels: ["security"],               // `backport` is added per release branch below
  },

  packageRules: [
    // ---- Routine updates (default branch in practice) ----
    {
      // gomod routine updates are patch-only: disable minor + major. This applies to every processed
      // branch, but release branches disable all routine updates anyway, so it only constrains the
      // default branch. Security fixes are forced through separately (vulnerabilityAlerts).
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    {
      // Group all k8s.io / sigs.k8s.io updates.
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "k8s",
    },
    {
      // Group all GitHub Actions updates into one PR.
      matchManagers: ["github-actions"],
      matchDepTypes: ["action"],
      groupName: "github-actions",
      separateMajorMinor: false,
    },

    // ---- Maintained release branches: security-only, backport-labelled ----
    {
      matchBaseBranches: ["/^release-3\\.\\d+$/"],
      addLabels: ["backport"],
    },
    {
      // Allow security fixes for indirect Go deps too (e.g. golang.org/x/text).
      matchBaseBranches: ["/^release-3\\.\\d+$/"],
      matchManagers: ["gomod"],
      matchDepTypes: ["indirect"],
      enabled: true,
    },
    {
      // Disable routine updates on release branches; security fixes still open via `force`.
      matchBaseBranches: ["/^release-3\\.\\d+$/"],
      matchUpdateTypes: [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance",
        "rollback",
        "replacement",
      ],
      enabled: false,
    },
  ],
}
